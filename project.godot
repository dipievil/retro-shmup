; Retro SHMUP - Godot 4.x Project File
; Engine version: 4.3.stable

config_version=5

[application]

config/name="Retro SHMUP"
config/description="A retro-style shoot-em-up game with 16-bit pixel art, dynamic audio, and anime cutscenes."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://scripts/autoload/game_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="viewport"
window/stretch/aspect="keep"
; Pixel art must scale by whole numbers only (Godot 4.2+).
window/stretch/scale_mode="integer"

[rendering]

; Required to export the universal (Intel + Apple Silicon) macOS preset
; from a Linux CI runner: ETC2/ASTC is otherwise imported only on hosts
; that prefer it, and Godot rejects universal macOS exports without it.
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
; 0 = Nearest, 1 = Linear (Godot 4.x canvas texture filter enum).
textures/canvas_textures/default_texture_filter=0
; Crisp low-res sprites: snap CanvasItem transforms, not vertices.
2d/snap/snap_2d_transforms_to_pixel=true
environment/defaults/default_clear_color=Color(0.04, 0.04, 0.08, 1)

[audio]

; Layered stems are built at runtime with AudioServer by
; scripts/autoload/audio_manager.gd (Music -> Master, stems -> Music/SFX).
; No on-disk bus layout is checked in: AudioManager owns the bus topology.
; See docs/plan.md "Dynamic Audio Design".
buses/default_bus_layout=""

[physics]

common/physics_ticks_per_second=60

[layer_names]

2d_physics/layer_1="player"
2d_physics/layer_2="player_projectiles"
2d_physics/layer_3="enemies"
2d_physics/layer_4="enemy_projectiles"
2d_physics/layer_5="pickups"
2d_physics/layer_6="environment"

[input]

; Controls follow docs/game_design.md#controls (parent repo) -- design target.
; Keyboard: LShift/LCtrl zoom, Q/W/E weapons, Space held fire, C speed cycle.
; Gamepad: R1/L1 zoom, R2/L2/A weapons, Y speed cycle, Back/Start menus.
; move = arrows + WASD + gamepad D-pad/left stick.
